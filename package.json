{
  "name": "arbor",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.4.2",
  "engines": {
    "node": "24.21.0"
  },
  "scripts": {
    "build": "tsc -b",
    "start": "node scripts/start-local.mjs",
    "typecheck": "tsc -b && tsc -p tsconfig.test.json",
    "test": "vitest run",
    "test:functional": "node scripts/testing/run-suite.mjs release",
    "test:functional:process": "node scripts/testing/run-suite.mjs process",
    "test:functional:ui": "node scripts/testing/run-suite.mjs ui",
    "test:functional:quick": "node scripts/testing/run-suite.mjs quick",
    "test:functional:smoke": "node scripts/testing/run-suite.mjs smoke",
    "test:functional:crash-sentinels": "node scripts/testing/run-suite.mjs crash-sentinels",
    "test:functional:package": "node scripts/testing/run-suite.mjs package",
    "test:quick": "node scripts/testing/run-suite.mjs quick",
    "test:smoke": "node scripts/testing/run-suite.mjs smoke",
    "test:crash-sentinels": "node scripts/testing/run-suite.mjs crash-sentinels",
    "test:package": "node scripts/testing/run-suite.mjs package",
    "test:ui": "node scripts/testing/run-suite.mjs ui",
    "test:release": "node scripts/testing/run-suite.mjs release",
    "test:all": "node scripts/testing/run-suite.mjs all",
    "test:manifest": "node --test scripts/testing/manifest.test.mjs scripts/testing/runner-utils.test.mjs scripts/testing/runner-startup.test.mjs && node scripts/testing/check-manifest.mjs",
    "check:release": "pnpm check && pnpm test:functional",
    "test:capability": "node scripts/testing/run-capability.mjs gray-box",
    "test:capability:real": "node scripts/testing/run-capability.mjs real-provider",
    "lint": "biome check .",
    "format": "biome format --write .",
    "architecture": "vitest run tests/architecture",
    "drill:restore": "pnpm build && node apps/single-workspace/dist/restore-drill.js",
    "assess:storage": "pnpm build && node apps/single-workspace/dist/storage-assessment-harness.js",
    "schema:upgrade": "pnpm build && node apps/single-workspace/dist/schema-upgrade.js",
    "check": "pnpm lint && pnpm typecheck && pnpm architecture && pnpm test && pnpm --filter @arbor/web typecheck && pnpm --filter @arbor/web build && pnpm --filter @arbor/web test"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@playwright/test": "1.63.0",
    "@types/node": "^24.13.5",
    "effect": "4.0.0-rc.115",
    "typescript": "7.0.2",
    "vitest": "5.0.1"
  },
  "dependencies": {
    "react-virtuoso": "^4.18.15"
  }
}
