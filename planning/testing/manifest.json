  "profiles": {
    "quick": {
      "description": "L1 focused module tests and type checks; not functional release qualification.",
      "groups": ["quick"],
      "build": true,
      "webTypecheck": true,
      "completeCoverage": false
    },
    "smoke": {
      "description": "S1-S4, selected public journeys, and safe daemon-startup handshake; not the complete public journey suite.",
      "groups": ["smoke"],
      "build": true,
      "completeCoverage": false
    },
    "crash-sentinels": {
      "description": "Curated crash, lease, and provider handoff sentinel files only; this profile does not qualify all AH10 handlers or AH1-AH19 coverage.",
      "groups": ["crashSentinels"],
      "build": true,
      "completeCoverage": false
    },
    "package": {
      "description": "Clean checkout/package boundary qualification.",
      "groups": ["package"],
      "build": true,
      "completeCoverage": false
    },
    "ui": {
      "description": "All configured functional browser files.",
      "groups": ["functionalUi"],
      "build": true,
      "completeCoverage": false
    },
    "process": {
      "description": "All configured functional Vitest files, without the browser suite.",
      "groups": ["functionalVitest"],
      "build": true,
      "completeCoverage": false
    },
    "release": {
      "description": "Complete configured functional Vitest and Playwright inventory; cache disabled and retries zero.",
      "groups": ["functionalVitest", "functionalUi"],
      "build": true,
      "completeCoverage": true,
      "cache": "never",
      "retries": 0
    },
    "all": {
      "description": "Alias profile for the complete functional inventory.",
      "groups": ["functionalVitest", "functionalUi"],
      "build": true,
      "completeCoverage": true,
      "cache": "never",
      "retries": 0
    }
  }
